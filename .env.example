# Copy to .env (scripts) and app/.env.local (app). Never commit the real files.

# ---- Scripts (scripts/) ----
# Localnet by default. For devnet use a Helius endpoint (free tier):
#   https://devnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>
RPC_URL=http://127.0.0.1:8899
# Admin / payer keypair, absolute path. Defaults to ~/.config/solana/id.json.
WALLET_PATH=

# ---- App (app/) ----
# RPC the browser talks to. NEXT_PUBLIC_* values ship to the client, so use a
# Helius key restricted to your app's domain, never a paid or mainnet key.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
# The program ID comes from the SDK, and the fee mint and treasury are read
# from the on-chain Config account, so the app needs nothing else.

# Demo mode, local only: a bar under the nav switches between the demo wallets
# in scripts/wallets/demo (Supplier, Buyer, Lender A, Lender B) without a wallet
# extension. Real devnet transactions. Run with `pnpm --filter app demo`, which
# binds to 127.0.0.1. Ignored on Vercel. Leave empty for the normal app.
SELO_DEMO_MODE=
