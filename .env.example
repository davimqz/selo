# ---- Scripts (scripts/) ----
# RPC used by scripts/src/*.ts. Localnet by default; devnet for the demo.
RPC_URL=http://127.0.0.1:8899
# Payer keypair (never commit keypairs).
# Defaults to ~/.config/solana/id.json when unset (absolute path required).
WALLET_PATH=

# ---- App (app/) ----
# Public RPC endpoint the browser talks to.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
# Selo program ID (same on localnet and devnet).
NEXT_PUBLIC_SELO_PROGRAM_ID=4zmhCsPLVfk7UEnEgpNfUTCcoXFX2tPbjyJtVit7Mhio
# Mock USDC mint created by `pnpm usdc:mock` (localnet) or the seed script (devnet).
NEXT_PUBLIC_USDC_MINT=
