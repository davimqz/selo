{
  "name": "selo",
  "private": true,
  "description": "Selo: programmable letter of credit on Solana",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build:program": "NO_DNA=1 anchor build",
    "codegen": "node scripts/codegen.mjs",
    "test:ts": "vitest run",
    "test:program": "NO_DNA=1 anchor build && pnpm run codegen && pnpm run test:ts",
    "typecheck": "tsc --noEmit && pnpm -r --filter sdk --filter scripts typecheck",
    "lint": "pnpm run lint:ts && pnpm run lint:rs && pnpm --filter app lint",
    "lint:ts": "prettier --check \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"sdk/src/*.ts\"",
    "lint:rs": "cargo fmt --all -- --check && cargo clippy --all-targets -- -D warnings",
    "format": "prettier --write \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"sdk/src/*.ts\" && cargo fmt --all",
    "localnet": "NO_DNA=1 surfpool start --no-tui",
    "usdc:mock": "pnpm --filter scripts usdc:mock"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.5.0",
    "@selo/sdk": "workspace:*",
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "8.3.0",
    "@types/node": "^24",
    "codama": "1.11.0",
    "litesvm": "1.4.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
