{
  "name": "selo",
  "private": true,
  "description": "Selo: programmable letter of credit on Solana",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:program": "anchor build",
    "test:ts": "ts-mocha -p ./tsconfig.json -t 1000000 \"tests/**/*.test.ts\"",
    "test:program": "anchor build && pnpm run test:ts",
    "lint": "pnpm run lint:ts && pnpm run lint:rs && pnpm --filter app lint",
    "lint:ts": "prettier --check \"tests/**/*.ts\" \"scripts/src/**/*.ts\"",
    "lint:rs": "cargo fmt --all -- --check && cargo clippy --all-targets -- -D warnings",
    "format": "prettier --write \"tests/**/*.ts\" \"scripts/src/**/*.ts\" && cargo fmt --all",
    "localnet": "solana-test-validator --reset --quiet",
    "usdc:mock": "pnpm --filter scripts usdc:mock"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24",
    "chai": "^4.5.0",
    "litesvm": "0.8.0",
    "mocha": "^10.8.2",
    "prettier": "^3.6.2",
    "ts-mocha": "^11.1.0",
    "typescript": "^5.9.3"
  }
}
