# Env and secrets — never commit keys.
# Keypairs are matched by name (a blanket *.json would also hide package.json).
.env
.env.*
!.env.example
*-keypair.json
*.keypair.json
id.json
keys/
wallets/
scripts/.localnet.json
scripts/.devnet.json

# OS / editor
.DS_Store
Thumbs.db
.vscode
